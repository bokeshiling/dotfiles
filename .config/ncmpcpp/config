# --- 1. 连接设置 ---
mpd_host = "127.0.0.1"
mpd_port = "6600"
mpd_music_dir = "~/Music"

# --- 2. 界面与交互 ---
user_interface = "alternative"
autocenter_mode = "yes"
mouse_support = "yes"
message_delay_time = "1"

# 窗口与状态栏可见性
header_visibility = "yes"
statusbar_visibility = "yes"
titles_visibility = "yes"
enable_window_title = "yes"

# 列表与显示格式（支持标签缺失降级）
song_status_format = "$7%t$9 $1by$9 $2%a$9"
song_list_format = "{{%a - %t}|{%f}}{$R%l}"

# 选定项与播放中样式
current_item_prefix = "$b$7"
now_playing_prefix = "$b$3"
now_playing_suffix = "$b$9"
progressbar_look = "─⊙─"

# 桌面切歌通知 (依赖 mpc 和 libnotify)
execute_on_song_change = notify-send "♫ Now Playing" "$(mpc current)"

# --- 3. 歌词引擎配置 ---
lyrics_directory = "~/.local/share/ncmpcpp/lyrics"
lyrics_fetchers = "tags, genius, internet"
follow_now_playing_lyrics = "yes"
fetch_lyrics_for_current_song_in_background = "yes"
store_lyrics_in_song_dir = "no"

# --- 4. 频谱可视化配置 ---
visualizer_data_source = "/run/user/1000/mpd.fifo"  # 若使用 /tmp 则保持 /tmp/mpd.fifo
visualizer_output_name = "Visualizer feed"
visualizer_in_stereo = "yes"
visualizer_type = "wave"
visualizer_look = "●▮"
