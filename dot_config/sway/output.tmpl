# vim:ft=swayconfig
# You can get the names of your outputs by running: swaymsg -t get_outputs

{{- $host := index .hosts .chezmoi.hostname }}
{{- $monitor := $host.monitor }}

output "{{ $monitor.name }}" {
	bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_"{{ $monitor.resolution }}".png fill
	mode {{ $monitor.mode }}Hz
    pos 0 0
}
